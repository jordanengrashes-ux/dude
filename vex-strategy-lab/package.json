{
  "name": "vex-strategy-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VEX V5 Override strategy simulator and optimizer: 3D field, Rapier physics, rules-based scoring, route optimization.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "vite-node scripts/sample-report.ts",
    "bench": "vite-node scripts/benchmark.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.17.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-node": "2.1.9",
    "vitest": "2.1.9"
  }
}
